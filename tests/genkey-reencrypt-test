#! /bin/sh

set -e

cd "$(dirname "$0")"

rm -f tmp.*

# Generate key encrypted with pass1
fp1=$(go run ../cmd/genkey-mldsa44 -N "pass1" -o tmp.key)
[ -n "$fp1" ]
# Re-encrypt with pass2
printf "tmp.key:pass1\n" >tmp.passfile
go run ../cmd/genkey-mldsa44 --reencrypt tmp.key -p tmp.passfile -N "pass2" -o tmp.key2
fp2=$(go run ../cmd/genkey-mldsa44 -l tmp.key2)
# Check keys are the same
[ "$fp1" = "$fp2" ]
# Check decrypting with pass2
printf "tmp.key2:pass2\n" >tmp.passfile2
go run ../cmd/sigsum-agent -k tmp.key2 -p tmp.passfile2 true
