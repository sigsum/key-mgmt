#!/bin/sh

set -e

cd "$(dirname "$0")"

rm -f tmp.*

pass="correct horse battery staple $$"
cat <<EOF >tmp.echopass.sh
#!/bin/bash
echo $pass
EOF
chmod +x tmp.echopass.sh

# Generate Ed25519 key with our genkey
go run ../cmd/genkey-mldsa44 -t ed25519 -N "$pass" -o tmp.key >/dev/null
mv tmp.key.pub tmp.key.pub.genkey
# Pull out the pubkey from the privkey using ssh-keygen, which does
# require decryption
SSH_ASKPASS=./tmp.echopass.sh SSH_ASKPASS_REQUIRE=force \
  ssh-keygen -y -f tmp.key >tmp.key.pub.sshkeygen
cmp tmp.key.pub.genkey tmp.key.pub.sshkeygen

# Generate Ed25519 key with ssh-keygen
ssh-keygen -q -t ed25519 -N "$pass" -f tmp.key2
sshfp=$(ssh-keygen -l -f tmp.key2 | grep -o "SHA256:\S\+")
[ -n "$sshfp" ]
# Check decrypting using sigsum-agent. Using script(1) to "type"
# passphrase on a tty.
printf "%s\n" "$pass" | script -c "go run ../cmd/sigsum-agent -k tmp.key2 ssh-add -l" tmp.scriptout >/dev/null
grep -q "\b$sshfp\b" tmp.scriptout

# Check decrypting using key passfile (only). Towards the above
# Ed25519 key, because using ssh-add
printf "\n# test comment\ntmp.key2:%s\n" "$pass" >tmp.passfile
go run ../cmd/sigsum-agent -p tmp.passfile -k tmp.key2 ssh-add -l 2>&1 | grep -q "\b$sshfp\b"

# Check that ML-DSA-44 can be decrypted using sigsum-agent
sshfp=$(go run ../cmd/genkey-mldsa44 -o tmp.key3 -N "$pass")
printf "tmp.key3:%s\n" "$pass" >tmp.passfile
go run ../cmd/sigsum-agent -p tmp.passfile -k tmp.key3 true
# Check getting FP privkey without needing to decrypt
go run ../cmd/genkey-mldsa44 -l tmp.key3 | grep -q "^$sshfp$"

# Check also without encryption
sshfp=$(go run ../cmd/genkey-mldsa44 -o tmp.key4 -N "")
go run ../cmd/sigsum-agent -k tmp.key4 true
[ -n "$sshfp" ]
go run ../cmd/genkey-mldsa44 -l tmp.key4 | grep -q "^$sshfp$"
