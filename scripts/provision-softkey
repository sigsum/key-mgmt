#!/bin/bash

set -eu
umask 077

say() {
  printf "\e[36mlocal: %s\e[0m\n" "$1"
}

target="${1?Give me target host that we can ssh to}"
# TODO should we have a final specific location, or take as argument?
targetkeyf=/etc/sigsum-agent/mldsa.key
# TODO should we parametrize the name of the EFI-variable in ./efivarpass ?

localkeyf=/dev/shm/mldsa-pass2.key
localpassf=/dev/shm/pass2

printf "Building tools ...\n"
go build -o . ./cmd/genkey-mldsa44 ./cmd/sigsum-agent
GOBIN=$PWD go install github.com/tillitis/tkey-random-generator/cmd/tkey-random-generator@main
printf "\n"

printf "After running this script, the generated key and passphrases will be stored as follows:\n"
printf "privkey(pass1) on %s in %s\n" "$target" "$targetkeyf"
printf "pass1          on %s in EFI-variable\n" "$target"
printf "privkey(pass2) on localhost in %s\n" "$localkeyf"
printf "pass2          on localhost in %s\n" "$localpassf"
printf "\n"
printf "First of all, local TKey will be used to generate entropy.\n"
printf "Provisioning will then continue over ssh to %s.\n" "$target"
printf "Hit RETURN to start\n"
read -r

errf=/tmp/provision-tkey-stderr
for varsize in pass1:16 pass2:16 tkeyentropy:32; do
  var=${varsize%:*}
  size=${varsize#*:}
  say "Using TKey TRNG to generate $size bytes for $var"
  if ! value=$(./tkey-random-generator generate "$size" 2>"$errf"); then
    cat "$errf" >/dev/stderr
    exit 1
  fi
  printf -v "$var" "%s" "$value"
done
rm -f "$errf"

printf "Copying tools to %s ...\n" "$target"
scp -q -p genkey-mldsa44 sigsum-agent ./scripts/efivarpass ./scripts/target-genkey \
    "$target":/tmp/

# Explicitly failing if a variable set using 'printf -v' is unset.
# shellcheck disable=SC2029  # Yes, expanding on client side
ssh "$target" sudo /tmp/target-genkey "$target" "${pass1:?}" "${pass2:?}" "${tkeyentropy:?}" "$targetkeyf" \
    >"$localkeyf"
say "Wrote privkey(pass2) to $localkeyf"
printf "%s" "$pass2" >"$localpassf"
say "Wrote pass2 to $localpassf"

./sigsum-agent -k "$localkeyf" -p <(printf "%s:%s" "$localkeyf" "$(cat "$localpassf")") true
say "Successfully ran sigsum-agent to decrypt $localkeyf using $localpassf"
