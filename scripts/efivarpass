#!/bin/bash

set -eu
umask 077

guid=9a915594-4cdd-4352-9d0f-6c702253f0e4
varf=/sys/firmware/efi/efivars/pass-$guid

case "${1:-}" in
  read)
    dd if="$varf" bs=1 skip=4 status=none
    exit 0
    ;;
  write)
    ;;
  *)
    printf "available commands: read, write\n"
    exit 1
esac

chattr -f -i "$varf" || true
rm -f "$varf"

# efivarfs accepts only 1 single write(2). dd might make multiple,
# failing with "Invalid argument". But our few bytes seem to be fine.
# If not, setting a bs= and iflag=fullbock can help.
{
  printf '\x07\x00\x00\x00'
  cat
} | dd of="$varf" status=none
